{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hugo0/awesome-agent-boards/blob/main/boards.schema.json",
  "title": "Agent board map",
  "description": "Public places where AI agents talk to each other. Every entry is listed; its group says which section it belongs in.",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked", "sections", "boards"],
  "properties": {
    "$schema": {"type": "string"},
    "checked": {"description": "Date the whole list was last re-read.", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sections": {"description": "Section titles for verified entries, in page order.", "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "group", "url", "link"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "group": {"description": "verified: meets the criteria. reported: named to us, not checked. completeness: checked, does not meet the criteria.", "enum": ["verified", "reported", "completeness"]},
          "section": {"description": "One of the top-level sections; verified entries only.", "type": "string", "minLength": 1},
          "url": {"description": "Public https address, or null when none is known.", "type": ["string", "null"], "pattern": "^https://[^\\s\"<>]+$"},
          "link": {"description": "Whether the address is rendered as a link. False for reported entries and for a domain that imitates another site.", "type": "boolean"},
          "about": {"description": "What the place is, one or two sentences.", "type": "string", "minLength": 1, "pattern": "\\.$"},
          "access": {"description": "How an agent reads and posts.", "type": "string", "minLength": 1, "pattern": "\\.$"},
          "identity": {"description": "What identity it asks for.", "type": "string", "minLength": 1, "pattern": "\\.$"},
          "note": {"description": "Where the report came from; reported entries only.", "type": "string", "minLength": 1, "pattern": "\\.$"},
          "reason": {"description": "Neutral one-line fact on why it is not in the main list; completeness entries only.", "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\.$"},
          "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"group": {"const": "verified"}}},
            "then": {
              "required": ["section", "about", "access", "identity", "checked"],
              "properties": {"url": {"type": "string"}, "link": {"const": true}, "note": false, "reason": false}
            }
          },
          {
            "if": {"properties": {"group": {"const": "reported"}}},
            "then": {
              "required": ["note"],
              "properties": {"url": {"type": "null"}, "link": {"const": false}, "section": false, "about": false, "access": false, "identity": false, "reason": false, "checked": false}
            }
          },
          {
            "if": {"properties": {"group": {"const": "completeness"}}},
            "then": {
              "required": ["reason", "checked"],
              "properties": {"section": false, "about": false, "access": false, "identity": false, "note": false}
            }
          }
        ]
      }
    }
  }
}
