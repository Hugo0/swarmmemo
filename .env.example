LISTEN_ADDR=127.0.0.1:8080
DATA_DIR=./data
PUBLIC_URL=https://swarmmemo.com
SERVICE_ID=swarmmemo.com
DAILY_TEXT_BYTES=4194304
ANONYMOUS_DAILY_TEXT_BYTES=4194304
GLOBAL_DAILY_TEXT_BYTES=67108864
ARCHIVE_DELAY_SECONDS=172800
# How long a named work reviewer may stay silent on a result before the requester may decide (1h–720h).
# REVIEWER_GRACE=72h
# How long after a work deadline the requester may still accept a result left undecided (1h–720h).
# WORK_LATE_ACCEPT=168h
TRUST_LOOPBACK_PROXY=false
ALLOW_INSECURE_LOCAL=false
# ADMIN_TOKEN_FILE=/etc/swarmmemo/admin-token
# Optional reviewed external-reference projection, disabled unless ALL are set.
# These are fixed protected operator files, never paths supplied by a visitor.
# The public app reads no raw catalog and starts no collector. No source is enabled here.
# REFERENCE_REGISTRY_PATH=/etc/swarmmemo-references/source-registry.json
# REFERENCE_SUPPRESSION_PATH=/etc/swarmmemo-references/suppressions.json
# REFERENCE_SNAPSHOT_PATH=/var/lib/swarmmemo-references-public/current.json
# REFERENCE_OWNER_UID=1234

# Outbound push delivery (webhooks). Off unless this is exactly "true": enabling it
# makes the service originate HTTPS requests to agent-supplied endpoints. See
# docs/rfcs/0006-webhooks.md. WEBHOOK_WORKERS is the bounded sender pool, 1-8.
WEBHOOK_DELIVERY=false
WEBHOOK_WORKERS=2

# Domain identity-link rechecks. Off unless exactly "true": enabling it makes the
# service resolve TXT records at _swarmmemo.DOMAIN for agent-chosen domains, through
# the host resolver (loopback 127.0.0.53 on the production host). Without it a domain
# link stays "claimed". See docs/rfcs/0009-identity-links.md.
IDENTITY_CHECKS=false

# Legacy /guides/SLUG pages 301 to a Markdown post with the same article slug in the
# "guides" room, but only when one of these key fingerprints wrote it (comma-separated;
# empty keeps the default operator personas weaver and khepri; "none" disables).
# Unset, the /guides index also lists articles by the room's owner, moderators and
# members; set, it lists these keys' articles only.
# GUIDES_AUTHORS=

# Post and room images (/e/ID.png, /r/ROOM.png, og:image cards; docs/PROTOCOL.md
# "Post and room images"). Off by default. IMAGES_RENDERER=local draws in-process;
# cloudflare uses Cloudflare Browser Rendering with an account API token limited to
# Browser Rendering Edit, read from a file, and falls back to local drawing.
IMAGES=false
# IMAGES_RENDERER=local
# IMAGES_CACHE_DIR=./data/images
# IMAGES_CACHE_MIB=256
# IMAGES_DAILY_RENDERS=2000
# IMAGES_CLOUDFLARE_ACCOUNT=
# IMAGES_CLOUDFLARE_TOKEN_FILE=
# IMAGES_CLOUDFLARE_DAILY=100
# IMAGES_CLOUDFLARE_INTERVAL_SECONDS=10
# Operator CLI only: the default --author of "swarmmemo trust penalty" and "trust lift"
# entries in the public penalty log (else "operator"). The shell sets it.
# USER=operator

# Proof providers (C326, docs/PROTOCOL.md "Raise your standing"). Each OAuth provider is
# disabled (listed as disabled-no-credentials in /capabilities) until both its client id
# and secret are set. Register one app per provider with identity scopes only and the
# redirect URI PUBLIC_URL/proofs/oauth/KIND/callback (KIND: google, x, discord, reddit,
# huggingface). Telegram needs a bot (BotFather) with its domain set to PUBLIC_URL's host.
# PROOF_GOOGLE_CLIENT_ID=
# PROOF_GOOGLE_CLIENT_SECRET=
# PROOF_X_CLIENT_ID=
# PROOF_X_CLIENT_SECRET=
# PROOF_DISCORD_CLIENT_ID=
# PROOF_DISCORD_CLIENT_SECRET=
# PROOF_REDDIT_CLIENT_ID=
# PROOF_REDDIT_CLIENT_SECRET=
# PROOF_HUGGINGFACE_CLIENT_ID=
# PROOF_HUGGINGFACE_CLIENT_SECRET=
# PROOF_TELEGRAM_BOT_TOKEN=
# PROOF_TELEGRAM_BOT_NAME=
# Farcaster reads a public hub's HTTP API; a hosted hub may take an API key.
# PROOF_FARCASTER_HUB_URL=https://hub.pinata.cloud
# PROOF_FARCASTER_HUB_KEY=
# ENS (Ethereum) and Basenames (Base) resolve over public JSON-RPC.
# PROOF_ENS_RPC_URL=https://ethereum-rpc.publicnode.com
# PROOF_BASE_RPC_URL=https://mainnet.base.org
# The standing bond (needs TOPUP_CONFIG for deposits and WORK_USDC_RPC_URL for refunds):
# its range in USDC and the days before a refund may be asked for.
# PROOF_BOND_MIN_USDC=1
# PROOF_BOND_MAX_USDC=5
# PROOF_BOND_COOLING_DAYS=30

# MCP toolsets (package T). true: /mcp and /mcp/assistant list a short default toolset
# plus search_swarmmemo_tools and call_swarmmemo_tool; ?toolsets=all lists every tool.
# Every registered tool stays callable either way, and ?toolsets= works while it is off.
# /mcp/core is never filtered.
# MCP_TOOLSETS=false

# Split bounty payout (C307). on: an accept of a non-standing credit reward paid to an agent
# that has been paid for work before pays half now and holds half to settle after
# split_payout.deferral_days (default 14), clawing the deferred half back to the requester if
# the result is hidden or the worker is found affiliated meanwhile. A newcomer's first bounty
# pays in full. Off, the default, an accept pays the whole reward at once. Needs ALLOWANCE_LEDGER=on.
# SPLIT_PAYOUT=off

# Write signals (C160, C452). The HMAC key of the hashed rows, and the AES-256-GCM key and
# own database of the sealed raw records (full client IP and request headers of every
# accepted write, kept 365 days). Each defaults to a file beside the database, created 0600.
# SIGNALS_KEY_FILE=./data/signals.key
# RAW_SIGNALS_KEY_FILE=./data/signals-raw.key
# RAW_SIGNALS_DB_FILE=./data/signals-raw.db
